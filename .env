ENV=sepolia # sepolia, mainnet
PHRASE="material toward work rib online drive pear word still robot kid man"
API_KEY="test" # don't forget to redefine the API key for the production environment
ETHERSCAN_API_KEY="your_etherscan_api_key"

INIT_TX_SYNC_BLOCK_BATCH_SIZE=250
INIT_BACKWARD_TX_SYNC_BLOCK_QUANTITY=0 # 0 means sync from the current block
ETH_BLOCK_INTERVAL=13000 # approx 13 seconds between blocks
PAYMENT_EXPIRATION_TIME_MINUTES=120 # 2 hours

DATABASE_URL=postgres://postgres:postgres@db:5432/crypto_payment_gateway